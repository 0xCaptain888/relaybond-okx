{
  "name": "relaybond-okx",
  "version": "0.4.0-rc.1",
  "private": false,
  "description": "Bonded provider routing and double-pay-free recovery for paid AI Agent services on OKX AI and X Layer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verifier": {
      "types": "./dist/verifier.d.ts",
      "import": "./dist/verifier.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "openapi.yaml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "hardhat compile && npm run build:sdk",
    "build:sdk": "tsc -p tsconfig.build.json",
    "vercel-build": "npm run build && npm run demo:continuity && npm run demo:official-coordinator && npm run build:web && node --import tsx scripts/build-vercel.ts",
    "build:web": "node --import tsx scripts/build-browser.ts",
    "verify:contract:xlayer-testnet": "node --env-file-if-exists=.env scripts/verify-xlayer-contract.cjs",
    "verify:contract:status": "node --env-file-if-exists=.env --import tsx scripts/check-contract-verification.ts",
    "deploy:xlayer-testnet": "node --env-file-if-exists=.env ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/deploy.cjs --network xLayerTestnet",
    "deploy:xlayer": "node --env-file-if-exists=.env ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/deploy.cjs --network xLayer",
    "bond:xlayer-testnet": "node --env-file-if-exists=.env ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/register-and-bond.cjs --network xLayerTestnet",
    "rebate:xlayer-testnet": "node --env-file-if-exists=.env ./node_modules/hardhat/internal/cli/bootstrap.js run scripts/claim-rebate.cjs --network xLayerTestnet",
    "rebate:live-breach": "node --env-file-if-exists=.env --import tsx scripts/claim-live-breach.ts",
    "evidence:refresh-live": "node --env-file-if-exists=.env --import tsx scripts/refresh-live-rebate.ts",
    "wallets:bootstrap": "node --import tsx scripts/bootstrap-wallets.ts",
    "wallets:status": "node --env-file-if-exists=.env --import tsx scripts/wallet-status.ts",
    "deployment:configure": "node --import tsx scripts/set-deployment-env.ts",
    "promise:generate": "node --env-file-if-exists=.env --import tsx scripts/generate-service-promise.ts",
    "buyer:live": "node --env-file-if-exists=.env --import tsx scripts/run-live-buyer.ts",
    "buyer:okx": "node --env-file-if-exists=.env --import tsx scripts/run-onchainos-buyer.ts",
    "fund:agentic-wallet": "node --env-file-if-exists=.env --import tsx scripts/fund-agentic-wallet.ts",
    "secrets:okx": "node --import tsx scripts/secure-okx-config.ts",
    "secrets:status": "node --env-file-if-exists=.env --import tsx scripts/secret-status.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:contract": "hardhat test",
    "demo": "node --import tsx scripts/judge-run.ts",
    "demo:continuity": "node --import tsx scripts/continuity-judge-run.ts",
    "demo:official-coordinator": "node --import tsx scripts/official-coordinator-run.ts",
    "verify:evidence": "node --import tsx scripts/verify-evidence.ts evidence/judge-run.json",
    "verify:live-paid": "node --import tsx scripts/verify-paid-evidence.ts",
    "verify:live-paid:onchain": "node --env-file-if-exists=.env --import tsx scripts/verify-paid-evidence.ts --onchain",
    "passport": "node --import tsx scripts/build-passport.ts",
    "api": "node --import tsx src/server.ts",
    "api:okx": "node --import tsx src/okx-server.ts",
    "serve": "npm run build:web && node --import tsx scripts/serve-demo.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm test && npm run build:web && npm run demo && npm run demo:continuity && npm run demo:official-coordinator && npm run verify:evidence && npm run verify:live-paid && npm run passport"
  },
  "dependencies": {
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "express": "^5.1.0",
    "undici": "^7.29.0",
    "viem": "^2.45.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@okxweb3/hardhat-explorer-verify": "^1.6.5",
    "@types/express": "^5.0.3",
    "@types/node": "^20.17.24",
    "hardhat": "^2.22.19",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2",
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "okx",
    "x-layer",
    "x402",
    "a2mcp",
    "ai-agents",
    "service-level-agreement",
    "quality-bond",
    "agent-recovery",
    "continuity-receipt"
  ],
  "license": "MIT"
}
